msgid "Enabling…"
msgstr "正在开启…"

#: htdocs/luci-static/resources/fwlive/logging.js:83
#: htdocs/luci-static/resources/fwlive/logging.js:130
msgid "Enable logging"
msgstr "开启日志"

#: htdocs/luci-static/resources/fwlive/logging.js:101
msgid "No WAN firewall zone found in /etc/config/firewall. Configure zones under "
msgstr "在 /etc/config/firewall 中未找到 WAN 防火墙区域。请在以下位置配置区域："

#: htdocs/luci-static/resources/fwlive/logging.js:108
msgid "Kernel netfilter log modules are missing. Install kmod-nf-log-ipv4 and kmod-nf-log-ipv6 (or kmod-nf-log / kmod-nf-log6), then reload the firewall."
msgstr "缺少内核 netfilter 日志模块。请安装 kmod-nf-log-ipv4 和 kmod-nf-log-ipv6（或 kmod-nf-log / kmod-nf-log6），然后重新加载防火墙。"

#: htdocs/luci-static/resources/fwlive/logging.js:116
#: htdocs/luci-static/resources/fwlive/logging.js:122
msgid "No firewall events yet"
msgstr "尚无防火墙事件"

#: htdocs/luci-static/resources/fwlive/logging.js:117
msgid "Logging is enabled on WAN. Waiting for firewall events — blocked inbound traffic appears here (not normal LAN browsing)."
msgstr "WAN 日志已开启。正在等待防火墙事件 — 被拦截的入站流量将显示在此处（不是正常的 LAN 浏览）。"

#: htdocs/luci-static/resources/fwlive/logging.js:118
msgid "Open firewall zone settings"
msgstr "打开防火墙区域设置"

#: htdocs/luci-static/resources/fwlive/logging.js:123
msgid "OpenWrt does not log firewall traffic until you turn it on. Enable logging to record blocked inbound traffic on WAN (rate-limited). Normal LAN browsing is not logged."
msgstr "在开启之前，OpenWrt 不会记录防火墙流量。开启日志可记录 WAN 上被拦截的入站流量（有速率限制）。普通局域网浏览不会被记录。"

#: htdocs/luci-static/resources/fwlive/logging.js:152
#: htdocs/luci-static/resources/fwlive/logging.js:156
msgid "Manual test (System → Terminal): "
msgstr "手动测试（系统 → 终端）："

#: htdocs/luci-static/resources/fwlive/logging.js:154
#: htdocs/luci-static/resources/fwlive/logging.js:158
msgid " then ping the router."
msgstr "，然后 ping 路由器。"

