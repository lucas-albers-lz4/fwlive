#: htdocs/luci-static/resources/view/status/fwlive.js:1537
msgid "How include vs exclude filters are shown on chips"
msgstr "标签上如何显示包含与排除筛选"

#: htdocs/luci-static/resources/view/status/fwlive.js:1545
msgid "Quick search"
msgstr "快速搜索"

#: htdocs/luci-static/resources/view/status/fwlive.js:1547
msgid "Any action"
msgstr "所有动作"

#: htdocs/luci-static/resources/view/status/fwlive.js:1553
