#: htdocs/luci-static/resources/view/status/fwlive.js:1527
msgid "Show hostnames"
msgstr "显示主机名"

#: htdocs/luci-static/resources/view/status/fwlive.js:1531
msgid "Filters look"
msgstr "过滤器外观"

