msgstr "%s: %s"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1830
msgid "0 matching · %d/%d stored"
msgstr "0 Treffer · %d/%d gespeichert"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:499
msgid "Accessible (teal/orange)"
msgstr "Barrierefrei (teal/orange)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:469
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:38
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2977
msgid "Action"
msgstr "Aktion"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:184
msgid ""
"Activate the message button or click a row to show or hide the full message"
msgstr ""
"Aktivieren Sie die Nachrichtenschaltfläche oder klicken Sie auf eine Zeile, "
"um die vollständige Meldung ein- oder auszublenden"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1011
msgid "Administrator access is required to disable logging."
msgstr ""
"Zum Deaktivieren der Protokollierung sind Administratorrechte erforderlich."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:995
msgid "Administrator access is required to enable logging."
msgstr ""
"Zum Aktivieren der Protokollierung sind Administratorrechte erforderlich."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:389
msgid "Allow/deny rules, LAN logging, or anything else."
msgstr "Allow/Deny-Regeln, LAN-Protokollierung oder irgendetwas anderes."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2064
msgid "Also seen"
msgstr "Weitere"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:67
msgid "Another change is staged for the firewall; apply or revert it first."
msgstr ""
"Eine andere Änderung an der Firewall ist vorgemerkt; zuerst anwenden oder "
"verwerfen."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:86
msgid ""
"Another change overwrote WAN logging after it was saved; check the current "
"state."
msgstr ""
"Eine andere Änderung hat die WAN-Protokollierung nach dem Speichern "
"überschrieben; prüfen Sie den aktuellen Zustand."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2980
msgid "Any action"
msgstr "Beliebige Aktion"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2057
msgid "Any protocol"
msgstr "Beliebiges Protokoll"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1533
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1605
msgid "Auto"
msgstr "Auto"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2630
msgid ""
"Auto reads extra kernel log lines so the table can fill; it is not the same "
"as Limit."
msgstr ""
"Auto liest zusätzliche Kernel-Log-Zeilen, damit die Tabelle füllen kann; das "
"ist nicht dasselbe wie Limit."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:379
msgid "Before you enable logging"
msgstr "Bevor Sie die Protokollierung aktivieren"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:65
msgid "Cannot enable logging until kernel log modules are installed."
msgstr ""
"Protokollierung kann erst aktiviert werden, wenn die Kernel-Log-Module "
"installiert sind."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:382
msgid "Changes:"
msgstr "Änderungen:"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:498
msgid "Classic (green/red)"
msgstr "Klassisch (grün/rot)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2670
msgid "Classic uses green/red; Accessible uses teal/orange"
msgstr "Klassisch verwendet grün/rot; Barrierefrei verwendet teal/orange"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2854
msgid "Clear"
msgstr "Leeren"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:94
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:274
msgid "Clear all"
msgstr "Alle löschen"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2699
msgid ""
"Clear empties the table. Already seen events stay hidden; new ones still "
"appear."
msgstr ""
"Leeren leert die Tabelle. Bereits gesehene Ereignisse bleiben ausgeblendet; "
"neue erscheinen weiter."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:3053
msgid ""
"Click a cell to filter · ≠ on a chip to exclude · Ctrl+click a rule for "
"firewall settings · in Simple view, activate the message button or click a "
"row to show or hide the full message"
msgstr ""
"Zelle anklicken zum Filtern · ≠ auf einem Chip zum Ausschließen · Strg+Klick "
"auf eine Regel für Firewall-Einstellungen · in der Einfachen Ansicht die "
"Nachrichtenschaltfläche aktivieren oder auf eine Zeile klicken, um die "
"vollständige Meldung ein- oder auszublenden"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2755
msgid ""
"Click an IP, action, or protocol to filter; use the Protocol menu (or ≠ on a "
"chip) to exclude."
msgstr ""
"Klicken Sie auf eine IP, Aktion oder ein Protokoll, um zu filtern; nutzen "
"Sie das Protokoll-Menü (oder ≠ auf einem Chip) zum Ausschließen."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2058
msgid "Common"
msgstr "Häufig"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:368
msgid ""
"Configured WAN zone log_limit: %s. It limits only on fw4 builds that support "
"it; kernel/logd may still constrain total log volume."
msgstr ""
"Konfiguriertes log_limit der WAN-Zone: %s. Es begrenzt die Rate nur auf fw4-"
"Versionen, die diese Option unterstützen; Kernel/logd können das "
"Gesamtvolumen weiterhin begrenzen."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1841
msgid "Connection lost — retrying…"
msgstr "Verbindung verloren — neuer Versuch…"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:71
msgid "Could not acquire the logging lock."
msgstr "Die Protokollierungssperre konnte nicht erworben werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:81
msgid "Could not clear the WAN zone log option."
msgstr "Die WAN-Zonen-Log-Option konnte nicht gelöscht werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:817
msgid "Could not create a temporary file for rule names."
msgstr "Für die Regelnamen konnte keine temporäre Datei erstellt werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1006
msgid "Could not disable logging."
msgstr "Protokollierung konnte nicht deaktiviert werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:984
msgid "Could not enable logging."
msgstr "Protokollierung konnte nicht aktiviert werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:920
msgid "Could not load logging status."
msgstr "Protokollstatus konnte nicht geladen werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:823
msgid "Could not load rule names."
msgstr "Die Regelnamen konnten nicht geladen werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:819
msgid "Could not process firewall rule names."
msgstr "Die Namen der Firewall-Regeln konnten nicht verarbeitet werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:963
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:996
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1012
msgid "Could not reach the router; check the current logging state."
msgstr ""
"Der Router konnte nicht erreicht werden; prüfen Sie den aktuellen "
"Protokollstatus."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:821
msgid "Could not read the active firewall rules."
msgstr "Die aktiven Firewall-Regeln konnten nicht gelesen werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:919
msgid "Could not refresh logging status; showing the last known state."
msgstr ""
"Protokollstatus konnte nicht aktualisiert werden; zeige den zuletzt "
"bekannten Zustand."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:828
msgid "Could not refresh rule names."
msgstr "Die Regelnamen konnten nicht aktualisiert werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:826
msgid "Could not refresh rule names; previously loaded names are still shown."
msgstr ""
"Die Regelnamen konnten nicht aktualisiert werden; die zuvor geladenen Namen "
"werden weiterhin angezeigt."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:83
msgid "Could not save the firewall configuration."
msgstr "Die Firewall-Konfiguration konnte nicht gespeichert werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:75
msgid "Could not snapshot the current logging state."
msgstr "Der aktuelle Protokollierungszustand konnte nicht gesichert werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:73
msgid "Could not track the logging change safely; logging was not changed."
msgstr ""
"Die Änderung der Protokollierung konnte nicht sicher nachverfolgt werden; "
"die Protokollierung wurde nicht geändert."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:79
msgid "Could not write the WAN zone log option."
msgstr "Die WAN-Zonen-Log-Option konnte nicht geschrieben werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:3008
msgid "Custom protocol (prefix ! to exclude). Overrides the menu when set."
msgstr ""
"Eigenes Protokoll (! zum Ausschließen). Überschreibt das Menü, wenn gesetzt."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:48
msgid "DPort"
msgstr "Ziel-Port"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:473
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:46
msgid "Destination"
msgstr "Ziel"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:3038
msgid "Destination IP contains (! to exclude)"
msgstr "Ziel-IP enthält (! zum Ausschließen)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:475
msgid "Destination port"
msgstr "Ziel-Port"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:3043
msgid "Destination port (! to exclude)"
msgstr "Ziel-Port (! zum Ausschließen)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2888
msgid "Detail"
msgstr "Detail"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2831
msgid "Details"
msgstr "Details"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:43
msgid "Dir"
msgstr "Richtung"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:313
msgid "Disabling…"
msgstr "Wird deaktiviert…"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1582
msgid ""
"Display limited to %d rows on this device; the larger Limit still buffers "
"rows."
msgstr ""
"Anzeige auf diesem Gerät auf %d Zeilen begrenzt; das größere Limit puffert "
"weiterhin Zeilen."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2608
msgid "Display options"
msgstr "Anzeigeoptionen"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2709
msgid ""
"Display options set Limit, row tint, palette, and hostnames. Fetch budget is "
"in Detail view."
msgstr ""
"Anzeigeoptionen setzen Limit, Zeileneinfärbung, Palette und Hostnamen. Das "
"Abrufbudget ist in der Detailansicht."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:387
msgid "Does not change:"
msgstr "Ändert nicht:"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:410
msgid "Don’t show this again"
msgstr "Nicht mehr anzeigen"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:226
msgid "Enable WAN zone drop/reject logging (same as Network → Firewall)."
msgstr ""
"Drop/Reject-Protokollierung der WAN-Zone aktivieren (wie unter Netzwerk → "
"Firewall)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:232
msgid "Enable logging"
msgstr "Protokollierung aktivieren"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2704
msgid ""
"Enable logging turns on WAN zone drop/reject logging only (same as Network → "
"Firewall). It does not add rules or log normal LAN browsing."
msgstr ""
"„Protokollierung aktivieren“ schaltet nur die Drop/Reject-Protokollierung "
"der WAN-Zone ein (wie unter Netzwerk → Firewall). Es fügt keine Regeln hinzu "
"und protokolliert keinen normalen LAN-Verkehr."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:232
msgid "Enabling…"
msgstr "Wird aktiviert…"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2071
msgid "Exclude"
msgstr "Ausschließen"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:91
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:190
msgid "Exclude instead"
msgstr "Stattdessen ausschließen"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2622
msgid "Fetch budget"
msgstr "Abrufbudget"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:63
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:84
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:149
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2977
msgid "Filter by %s"
msgstr "Filtern nach %s"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:122
msgid "Filter logs by rule (hint: %s). Ctrl+click to open firewall settings."
msgstr ""
"Logs nach Regel filtern (Hinweis: %s). Strg+Klick öffnet die Firewall-"
"Einstellungen."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2793
#: openwrt-feed/luci-app-fwlive/root/usr/share/luci/menu.d/luci-app-fwlive.json:3
msgid "Firewall Live View"
msgstr "Firewall-Live-Ansicht"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1808
msgid "Firewall log has no current entries; showing rows last received %s ago."
msgstr ""
"Im Firewall-Protokoll sind derzeit keine Einträge; angezeigt werden Zeilen, "
"die zuletzt vor %s empfangen wurden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:49
msgid "Flags"
msgstr "Flags"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:51
msgid "Flow"
msgstr "Fluss"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2729
msgid ""
"For a responsive table on a weak device, keep Limit at 250 rows or below. "
"The weak-device cap affects rendered rows; the buffer can still retain more."
msgstr ""
"Für eine responsive Tabelle auf einem schwachen Gerät sollte Limit auf "
"höchstens 250 Zeilen stehen. Die Schwachgerätebegrenzung betrifft die "
"angezeigten Zeilen; der Puffer kann weiterhin mehr Zeilen behalten."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:64
msgid "Forwarded"
msgstr "Weitergeleitet"

#: openwrt-feed/luci-app-fwlive/root/usr/share/rpcd/acl.d/luci-app-fwlive.json:3
msgid "Grant access to firewall live log view"
msgstr "Zugriff auf die Live-Ansicht der Firewall-Protokolle gewähren"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2690
msgid "Help"
msgstr "Hilfe"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:151
msgid "Hide full message"
msgstr "Vollständige Nachricht ausblenden"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1680
msgid "Hide rows"
msgstr "Zeilen ausblenden"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1578
msgid "Hostname lookup paused while the router is under load."
msgstr "Hostnamenauflösung pausiert, solange der Router ausgelastet ist."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2062
msgid "ICMPv6"
msgstr "ICMPv6"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:41
msgid "IN"
msgstr "EINGANG"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2766
msgid ""
"If Row tint looks missing, the active LuCI theme may omit success/error or "
"info/warn CSS variables; fwlive falls back to local colors (air-gapped, no "
"data leaves the device)."
msgstr ""
"Wenn die Zeileneinfärbung fehlt, verwendet das aktive LuCI-Theme "
"möglicherweise keine Erfolgs/Fehler-CSS-Variablen; fwlive fällt auf lokale "
"Farben zurück (air-gapped, keine Daten verlassen das Gerät)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:513
msgid ""
"If the WAN is quiet, wait for probes or use the optional ping check in "
"Help / the enabling-logs guide."
msgstr ""
"Wenn das WAN ruhig ist, warten Sie auf Probes oder nutzen Sie den optionalen "
"Ping-Test in der Hilfe / der Anleitung zum Aktivieren der Protokollierung."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2750
msgid ""
"In Simple view, activate the message button or click a row to show or hide "
"the full message."
msgstr ""
"In der einfachen Ansicht können Sie die Nachrichtenschaltfläche aktivieren "
"oder auf eine Zeile klicken, um die vollständige Meldung ein- oder "
"auszublenden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:62
msgid "Inbound"
msgstr "Eingehend"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:92
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:190
msgid "Include instead"
msgstr "Stattdessen einschließen"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:478
msgid ""
"Install kmod-nf-log and kmod-nf-log6 with the command for your OpenWrt "
"release, then reload the firewall."
msgstr ""
"Installieren Sie kmod-nf-log und kmod-nf-log6 mit dem Befehl für Ihre "
"OpenWrt-Version und laden Sie dann die Firewall neu."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1839
msgid "Installation is incomplete. Reinstall luci-app-fwlive."
msgstr "Installation unvollständig. Installieren Sie luci-app-fwlive neu."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:470
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:40
msgid "Interface"
msgstr "Schnittstelle"

