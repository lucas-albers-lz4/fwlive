msgstr "%ds"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1552
msgid "%s · requested up to %d raw lines · %d firewall messages returned"
msgstr ""
"%s · bis zu %d Rohzeilen angefordert · %d Firewall-Meldungen zurückgegeben"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1542
msgid ""
"%s · requested up to %d raw lines · server limited fetch to %d · %d firewall "
"messages returned"
msgstr ""
"%s · bis zu %d Rohzeilen angefordert · Server begrenzte Abruf auf %d · %d "
"Firewall-Meldungen zurückgegeben"

