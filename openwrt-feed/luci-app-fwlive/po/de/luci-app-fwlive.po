msgid "View"
msgstr "Ansicht"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1007
msgid "WAN drop/reject logging is off."
msgstr "WAN-Drop/Reject-Protokollierung ist aus."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:506
msgid ""
"WAN drop/reject logging is on. Blocked inbound WAN traffic will show up "
"here. Normal LAN browsing will not."
msgstr ""
"WAN-Drop/Reject-Protokollierung ist an. Blockierter eingehender WAN-Verkehr "
"erscheint hier. Normales LAN-Surfen nicht."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:988
msgid ""
"WAN drop/reject logging is on. Blocked inbound traffic should appear here as "
"it happens — not normal LAN browsing."
msgstr ""
"WAN-Drop/Reject-Protokollierung ist an. Blockierter eingehender Verkehr "
"sollte hier in Echtzeit erscheinen — nicht normales LAN-Surfen."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:990
msgid "WAN logging is already enabled."
msgstr "WAN-Protokollierung ist bereits aktiviert."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:316
