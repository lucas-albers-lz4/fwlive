msgstr "%s: %s"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1854
msgid "0 matching · %d/%d stored"
msgstr "0 совпад. · сохранено %d/%d"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:521
msgid "Accessible (teal/orange)"
msgstr "Доступный (бирюзовый/оранжевый)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:469
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:38
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:3001
msgid "Action"
msgstr "Действие"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:184
msgid ""
"Activate the message button or click a row to show or hide the full message"
msgstr ""
"Активируйте кнопку сообщения или нажмите на строку, чтобы показать или "
"скрыть полное сообщение"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1034
msgid "Administrator access is required to disable logging."
msgstr "Для отключения журналирования требуются права администратора."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1018
msgid "Administrator access is required to enable logging."
msgstr "Для включения журналирования требуются права администратора."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:394
msgid "Allow/deny rules, LAN logging, or anything else."
msgstr "Правила allow/deny, журналирование LAN и любые другие настройки."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2087
msgid "Also seen"
msgstr "Также встречаются"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:67
msgid "Another change is staged for the firewall; apply or revert it first."
msgstr ""
"В брандмауэре уже есть другое незафиксированное изменение; сначала примените "
"или отмените его."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:86
msgid ""
"Another change overwrote WAN logging after it was saved; check the current "
"state."
msgstr ""
"Другое изменение перезаписало журналирование WAN после сохранения; проверьте "
"текущее состояние."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:3004
msgid "Any action"
msgstr "Любое действие"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2080
msgid "Any protocol"
msgstr "Любой протокол"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1556
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1628
msgid "Auto"
msgstr "Авто"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2654
msgid ""
"Auto reads extra kernel log lines so the table can fill; it is not the same "
"as Limit."
msgstr ""
"Авто читает дополнительные строки журнала ядра, чтобы таблица могла "
"заполниться; это не то же самое, что Limit."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:384
msgid "Before you enable logging"
msgstr "Перед включением журналирования"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:65
msgid "Cannot enable logging until kernel log modules are installed."
msgstr ""
"Невозможно включить журналирование, пока не установлены модули журнала ядра."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:387
msgid "Changes:"
msgstr "Изменения:"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:520
msgid "Classic (green/red)"
msgstr "Классический (зелёный/красный)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2694
msgid "Classic uses green/red; Accessible uses teal/orange"
msgstr "Классический — зелёный/красный; доступный — бирюзовый/оранжевый"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2878
msgid "Clear"
msgstr "Очистить"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:94
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:274
msgid "Clear all"
msgstr "Очистить всё"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2723
msgid ""
"Clear empties the table. Already seen events stay hidden; new ones still "
"appear."
msgstr ""
"Очистить опустошает таблицу. Уже показанные события остаются скрытыми; новые "
"всё равно появляются."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:3077
msgid ""
"Click a cell to filter · ≠ on a chip to exclude · Ctrl+click a rule for "
"firewall settings · in Simple view, activate the message button or click a "
"row to show or hide the full message"
msgstr ""
"Щёлкните ячейку для фильтра · ≠ на чипе для исключения · Ctrl+щелчок по "
"правилу для настроек МЭ · в Простом виде активируйте кнопку сообщения или "
"нажмите на строку, чтобы показать или скрыть полное сообщение"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2779
msgid ""
"Click an IP, action, or protocol to filter; use the Protocol menu (or ≠ on a "
"chip) to exclude."
msgstr ""
"Щёлкните по IP, действию или протоколу для фильтрации; для исключения "
"используйте меню «Протокол» (или ≠ на чипе)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2081
msgid "Common"
msgstr "Частые"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:373
msgid ""
"Configured WAN zone log_limit: %s. It limits only on fw4 builds that support "
"it; kernel/logd may still constrain total log volume."
msgstr ""
"Настроенный log_limit зоны WAN: %s. Ограничение действует только в сборках "
"fw4 с поддержкой этой опции; ядро/logd всё ещё могут ограничивать общий "
"объём журналов."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1865
msgid "Connection lost — retrying…"
msgstr "Соединение потеряно — повторная попытка…"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:71
msgid "Could not acquire the logging lock."
msgstr "Не удалось получить блокировку журналирования."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:81
msgid "Could not clear the WAN zone log option."
msgstr "Не удалось очистить параметр журнала зоны WAN."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:839
msgid "Could not create a temporary file for rule names."
msgstr "Не удалось создать временный файл для имён правил."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1029
msgid "Could not disable logging."
msgstr "Не удалось отключить журналирование."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1007
msgid "Could not enable logging."
msgstr "Не удалось включить журналирование."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:943
msgid "Could not load logging status."
msgstr "Не удалось загрузить состояние журналирования."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:845
msgid "Could not load rule names."
msgstr "Не удалось загрузить имена правил."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:841
msgid "Could not process firewall rule names."
msgstr "Не удалось обработать имена правил межсетевого экрана."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:986
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1019
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1035
msgid "Could not reach the router; check the current logging state."
msgstr ""
"Не удалось связаться с маршрутизатором; проверьте текущее состояние "
"журналирования."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:843
msgid "Could not read the active firewall rules."
msgstr "Не удалось прочитать действующие правила межсетевого экрана."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:942
msgid "Could not refresh logging status; showing the last known state."
msgstr ""
"Не удалось обновить состояние журналирования; показан последний известный "
"статус."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:850
msgid "Could not refresh rule names."
msgstr "Не удалось обновить имена правил."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:848
msgid "Could not refresh rule names; previously loaded names are still shown."
msgstr ""
"Не удалось обновить имена правил; отображаются ранее загруженные имена."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:83
msgid "Could not save the firewall configuration."
msgstr "Не удалось сохранить конфигурацию межсетевого экрана."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:75
msgid "Could not snapshot the current logging state."
msgstr "Не удалось сохранить снимок текущего состояния журналирования."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:73
msgid "Could not track the logging change safely; logging was not changed."
msgstr ""
"Не удалось безопасно отследить изменение журналирования; журналирование не "
"изменено."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:79
msgid "Could not write the WAN zone log option."
msgstr "Не удалось записать параметр журнала зоны WAN."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:3032
msgid "Custom protocol (prefix ! to exclude). Overrides the menu when set."
msgstr "Свой протокол (! для исключения). Переопределяет меню, если задан."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:48
msgid "DPort"
msgstr "Порт назн."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:473
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:46
msgid "Destination"
msgstr "Назначение"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:3062
msgid "Destination IP contains (! to exclude)"
msgstr "IP назначения содержит (! для исключения)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:475
msgid "Destination port"
msgstr "Порт назначения"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:3067
msgid "Destination port (! to exclude)"
msgstr "Порт назначения (! для исключения)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2912
msgid "Detail"
msgstr "Подробно"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2855
msgid "Details"
msgstr "Подробности"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:43
msgid "Dir"
msgstr "Напр."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:313
msgid "Disabling…"
msgstr "Отключение…"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1605
msgid ""
"Display limited to %d rows on this device; the larger Limit still buffers "
"rows."
msgstr ""
"Отображение ограничено %d строками на этом устройстве; больший лимит по-"
"прежнему буферизует строки."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2632
msgid "Display options"
msgstr "Параметры отображения"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2733
msgid ""
"Display options set Limit, row tint, palette, and hostnames. Fetch budget is "
"in Detail view."
msgstr ""
"Параметры отображения задают Limit, окраску строк, палитру и имена узлов. "
"Бюджет выборки — в подробном виде."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:392
msgid "Does not change:"
msgstr "Не изменяет:"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:415
msgid "Don’t show this again"
msgstr "Больше не показывать"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:226
msgid "Enable WAN zone drop/reject logging (same as Network → Firewall)."
msgstr ""
"Включить журналирование drop/reject для WAN-зоны (как в Сеть → Межсетевой "
"экран)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:232
msgid "Enable logging"
msgstr "Включить журналирование"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2728
msgid ""
"Enable logging turns on WAN zone drop/reject logging only (same as Network → "
"Firewall). It does not add rules or log normal LAN browsing."
msgstr ""
"«Включить журналирование» включает только журналирование drop/reject для WAN-"
"зоны (как в Сеть → Межсетевой экран). Оно не добавляет правил и не "
"журналирует обычный LAN-трафик."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:232
msgid "Enabling…"
msgstr "Включение…"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2094
msgid "Exclude"
msgstr "Исключить"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:91
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:190
msgid "Exclude instead"
msgstr "Исключить вместо этого"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2646
msgid "Fetch budget"
msgstr "Бюджет выборки"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:143
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:167
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:242
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:3001
msgid "Filter by %s"
msgstr "Фильтр по %s"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:210
msgid "Filter logs by rule (hint: %s). Ctrl+click to open firewall settings."
msgstr ""
"Фильтр журналов по правилу (подсказка: %s). Ctrl+клик открывает настройки "
"файрвола."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2817
#: openwrt-feed/luci-app-fwlive/root/usr/share/luci/menu.d/luci-app-fwlive.json:3
msgid "Firewall Live View"
msgstr "Просмотр файрвола в реальном времени"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1831
msgid "Firewall log has no current entries; showing rows last received %s ago."
msgstr ""
"В журнале межсетевого экрана сейчас нет записей; показаны строки, полученные "
"%s назад."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:49
msgid "Flags"
msgstr "Флаги"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:51
msgid "Flow"
msgstr "Поток"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2753
msgid ""
"For a responsive table on a weak device, keep Limit at 250 rows or below. "
"The weak-device cap affects rendered rows; the buffer can still retain more."
msgstr ""
"Для отзывчивой таблицы на слабом устройстве установите Лимит не выше 250 "
"строк. Ограничение слабого устройства влияет на отображаемые строки; буфер "
"всё ещё может хранить больше."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:64
msgid "Forwarded"
msgstr "Транзитный"

#: openwrt-feed/luci-app-fwlive/root/usr/share/rpcd/acl.d/luci-app-fwlive.json:3
msgid "Grant access to firewall live log view"
msgstr "Предоставить доступ к живому просмотру журнала межсетевого экрана"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2714
msgid "Help"
msgstr "Справка"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:151
msgid "Hide full message"
msgstr "Скрыть полное сообщение"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1703
msgid "Hide rows"
msgstr "Скрыть строки"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1601
msgid "Hostname lookup paused while the router is under load."
msgstr "Разрешение имён приостановлено из-за нагрузки на маршрутизатор."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2085
msgid "ICMPv6"
msgstr "ICMPv6"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:41
msgid "IN"
msgstr "ВХОД"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2790
msgid ""
"If Row tint looks missing, the active LuCI theme may omit success/error or "
"info/warn CSS variables; fwlive falls back to local colors (air-gapped, no "
"data leaves the device)."
msgstr ""
"Если цветовая маркировка строк отсутствует, активная тема LuCI может не "
"содержать CSS-переменные success/error или info/warn; fwlive использует "
"локальные цвета (работает автономно, данные не покидают устройство)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:518
msgid ""
"If the WAN is quiet, wait for probes or use the optional ping check in "
"Help / the enabling-logs guide."
msgstr ""
"Если WAN неактивен, дождитесь проб или используйте необязательную проверку "
