msgid "Palette"
msgstr "Палитра"

#: htdocs/luci-static/resources/view/status/fwlive.js:1519
msgid "Classic uses green/red; Accessible uses teal/orange"
msgstr "Классический — зелёный/красный; доступный — бирюзовый/оранжевый"

#: htdocs/luci-static/resources/view/status/fwlive.js:1527
msgid "Show hostnames"
msgstr "Показывать имена хостов"

#: htdocs/luci-static/resources/view/status/fwlive.js:1531
msgid "Filters look"
msgstr "Вид фильтров"

#: htdocs/luci-static/resources/view/status/fwlive.js:1533
msgid "Chip style"
msgstr "Стиль чипов"

#: htdocs/luci-static/resources/view/status/fwlive.js:1537
msgid "How include vs exclude filters are shown on chips"
msgstr "Как на чипах отображаются фильтры включения и исключения"

#: htdocs/luci-static/resources/view/status/fwlive.js:1545
msgid "Quick search"
msgstr "Быстрый поиск"

#: htdocs/luci-static/resources/view/status/fwlive.js:1547
msgid "Any action"
msgstr "Любое действие"

#: htdocs/luci-static/resources/view/status/fwlive.js:1553
msgid "not pass"
msgstr "не пропускать"

#: htdocs/luci-static/resources/view/status/fwlive.js:1554
msgid "not drop"
msgstr "не отбрасывать"

#: htdocs/luci-static/resources/view/status/fwlive.js:1555
msgid "not block"
msgstr "не блокировать"

#: htdocs/luci-static/resources/view/status/fwlive.js:1556
msgid "not reject"
msgstr "не отклонять"

#: htdocs/luci-static/resources/view/status/fwlive.js:1557
msgid "not unknown"
msgstr "не неизвестно"

#: htdocs/luci-static/resources/view/status/fwlive.js:1559
msgid "Protocol (prefix ! to exclude)"
msgstr "Протокол (! в начале для исключения)"

#: htdocs/luci-static/resources/view/status/fwlive.js:1562
msgid "More filters"
msgstr "Больше фильтров"

#: htdocs/luci-static/resources/view/status/fwlive.js:1564
msgid "Interface (prefix ! to exclude)"
msgstr "Интерфейс (! в начале для исключения)"

#: htdocs/luci-static/resources/view/status/fwlive.js:1565
msgid "Source IP contains (! to exclude)"
msgstr "IP источника содержит (! для исключения)"

#: htdocs/luci-static/resources/view/status/fwlive.js:1566
msgid "Source port (! to exclude)"
msgstr "Порт источника (! для исключения)"

#: htdocs/luci-static/resources/view/status/fwlive.js:1567
msgid "Destination IP contains (! to exclude)"
msgstr "IP назначения содержит (! для исключения)"

#: htdocs/luci-static/resources/view/status/fwlive.js:1568
msgid "Destination port (! to exclude)"
msgstr "Порт назначения (! для исключения)"

#: htdocs/luci-static/resources/view/status/fwlive.js:1574
msgid "Click a cell to filter · ≠ on a chip to exclude · Ctrl+click a rule for firewall settings"
msgstr "Клик по ячейке — фильтр · ≠ на чипе — исключить · Ctrl+клик по правилу — настройки файрвола"

#: htdocs/luci-static/resources/view/status/fwlive.js:1587
msgid "Help"
msgstr "Справка"

#: htdocs/luci-static/resources/view/status/fwlive.js:1589
msgid "The table updates automatically when your firewall logs traffic. Use Pause if it moves too fast."
msgstr "Таблица обновляется автоматически, когда файрвол пишет в журнал. Используйте Паузу, если слишком быстро."

#: htdocs/luci-static/resources/view/status/fwlive.js:1590
msgid "Enable logging turns on WAN zone drop/reject logging (same as Network → Firewall). LAN browsing is not logged by default."
msgstr "Включение журналирования активирует запись отбрасываний/отклонений в зоне WAN (как в Сеть → Файрвол). Просмотр LAN по умолчанию не журналируется."

#: htdocs/luci-static/resources/view/status/fwlive.js:1591
msgid "Display options hides Limit, row tint, hostnames, and chip style."
msgstr "Параметры отображения скрывают лимит, окраску строк, имена хостов и стиль чипов."

#: htdocs/luci-static/resources/view/status/fwlive.js:1592
msgid "The rate shown for WAN logging is the firewall zone log_limit. OpenWrt defaults to 10/minute when no explicit limit is configured; fwlive does not impose this cap."
msgstr "Показанная частота WAN-журнала — log_limit зоны. По умолчанию OpenWrt: 10/мин без явного лимита; fwlive сам лимит не задаёт."

#: htdocs/luci-static/resources/view/status/fwlive.js:1594
msgid "Click a row to see the full log line (Simple view)."
msgstr "Нажмите на строку, чтобы увидеть полную строку журнала (Простой вид)."

#: htdocs/luci-static/resources/view/status/fwlive.js:1595
msgid "Click an IP, action, or protocol to filter; click ≠ on a filter chip to exclude that value instead."
msgstr "Нажмите на IP, действие или протокол для фильтрации; нажмите ≠ на чипе фильтра, чтобы исключить это значение."

#: htdocs/luci-static/resources/view/status/fwlive.js:1596
msgid "Chip style chooses how include vs exclude chips look (Labels, Symbols, or Tone). Default is Labels."
msgstr "Стиль чипов задаёт вид включения и исключения (Подписи, Символы или Тон). По умолчанию — Подписи."

#: htdocs/luci-static/resources/view/status/fwlive.js:1597
msgid "Row tint toggles pass/deny row backgrounds. When on, choose Classic (green/red, default) or Accessible (teal/orange). Action text stays colored either way."
msgstr "Подсветка строк включает фоны pass/deny. Когда включена, выберите классический (зелёный/красный, по умолчанию) или доступный (бирюзовый/оранжевый). Цвет текста действия сохраняется в любом случае."

#: htdocs/luci-static/resources/view/status/fwlive.js:1598
msgid "Use Show Detail for all columns (flags, length, raw message)."
msgstr "Используйте «Показать детали» для всех столбцов (флаги, длина, исходное сообщение)."

#: htdocs/luci-static/resources/view/status/fwlive.js:1599
msgid "If Row tint looks missing, the active LuCI theme may omit success/error or info/warn CSS variables; fwlive falls back to local colors (air-gapped, no data leaves the device)."
msgstr "Если цветовая маркировка строк отсутствует, активная тема LuCI может не содержать CSS-переменные успеха/ошибки; fwlive использует локальные цвета (изолированно, данные не покидают устройство)."

