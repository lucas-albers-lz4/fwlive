msgid "Another change overwrote WAN logging after it was saved; check the current state."
msgstr "Другое изменение перезаписало журналирование WAN после сохранения; проверьте текущее состояние."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2710
