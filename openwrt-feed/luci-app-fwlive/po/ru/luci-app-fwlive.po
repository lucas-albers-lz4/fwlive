msgstr "0 совпад. · сохранено %d/%d"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:403
msgid "Accessible (teal/orange)"
msgstr "Доступный (бирюзовый/оранжевый)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:328
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:35
msgid "Action"
msgstr "Действие"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:754
msgid "Administrator access is required to disable logging."
msgstr "Для отключения журналирования требуются права администратора."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:723
msgid "Administrator access is required to enable logging."
msgstr "Для включения журналирования требуются права администратора."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:148
msgid "Allow/deny rules, LAN logging, or anything else."
msgstr "Правила allow/deny, журналирование LAN и любые другие настройки."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1564
msgid "Also seen"
msgstr "Также встречаются"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:707
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:744
msgid "Another change is staged for the firewall; apply or revert it first."
msgstr ""
"В брандмауэре уже есть другое незафиксированное изменение; сначала примените "
"или отмените его."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2261
msgid "Any action"
msgstr "Любое действие"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1557
msgid "Any protocol"
msgstr "Любой протокол"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1182
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1233
msgid "Auto"
msgstr "Авто"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:138
msgid "Before you enable logging"
msgstr "Перед включением журналирования"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:703
msgid "Cannot enable logging until kernel log modules are installed."
msgstr ""
"Невозможно включить журналирование, пока не установлены модули журнала ядра."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:141
msgid "Changes:"
msgstr "Изменения:"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:402
msgid "Classic (green/red)"
msgstr "Классический (зелёный/красный)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2234
msgid "Classic uses green/red; Accessible uses teal/orange"
msgstr "Классический — зелёный/красный; доступный — бирюзовый/оранжевый"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:148
msgid "Clear all"
msgstr "Очистить всё"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2333
msgid ""
"Click a cell to filter · ≠ on a chip to exclude · Ctrl+click a rule for "
"firewall settings · in Simple view, click a row for the full message"
msgstr ""
"Щёлкните ячейку для фильтра · ≠ на чипе для исключения · Ctrl+щелчок по "
"правилу для настроек МЭ · в Простом виде щёлкните строку для полного "
"сообщения"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2403
msgid ""
"Click a row (Time or other non-link cells) to see the full log line (Simple "
"view)."
msgstr ""
"Щёлкните строку (Время или другие ячейки без ссылки), чтобы увидеть полную "
"строку журнала (Простой вид)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:139
msgid "Click a row for the full message"
msgstr "Щёлкните строку для полного сообщения"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2408
msgid ""
"Click an IP, action, or protocol to filter; use the Protocol menu (or ≠ on a "
"chip) to exclude."
msgstr ""
"Щёлкните по IP, действию или протоколу для фильтрации; для исключения "
"используйте меню «Протокол» (или ≠ на чипе)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1558
msgid "Common"
msgstr "Частые"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1394
msgid "Connection lost — retrying…"
msgstr "Соединение потеряно — повторная попытка…"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:746
msgid "Could not disable logging."
msgstr "Не удалось отключить журналирование."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:709
msgid "Could not enable logging."
msgstr "Не удалось включить журналирование."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2288
msgid "Custom protocol (prefix ! to exclude). Overrides the menu when set."
msgstr "Свой протокол (! для исключения). Переопределяет меню, если задан."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:45
msgid "DPort"
msgstr "Порт назн."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1039
msgid "Degraded — sampling"
msgstr "Упрощённый режим — выборка"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1213
msgid "Degraded — sampling (slow poll RTT; cadence reduced)."
msgstr "Упрощённый режим — выборка (медленный RTT опроса; интервал увеличен)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:332
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:43
msgid "Destination"
msgstr "Назначение"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2318
msgid "Destination IP contains (! to exclude)"
msgstr "IP назначения содержит (! для исключения)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:334
msgid "Destination port"
msgstr "Порт назначения"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2323
msgid "Destination port (! to exclude)"
msgstr "Порт назначения (! для исключения)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2094
msgid "Detail"
msgstr "Подробно"

