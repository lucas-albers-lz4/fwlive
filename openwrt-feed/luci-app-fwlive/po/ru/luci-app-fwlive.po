#: applications/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1646
msgid "Message"
msgstr "Сообщение"

#: applications/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1571
