#!/bin/sh
# rpcd plugin: ubus object "fwlive"
#   rules   — rule hint map (no args)
#   poll    — firewall-only log tail; pass line count as addresses[0] (rpcd array schema)
#   resolve — reverse DNS for IP addresses (getent)
#   logging_status — WAN zone logging readiness (no args)
#   enable_wan_logging / disable_wan_logging — opt-in WAN zone log=1 (no args)

FW4_TAG='!fw4: '
LIBEXEC_DIR="$(cd "$(dirname "$0")/.." && pwd)"
FILTER_SH="$LIBEXEC_DIR/fwlive-log-filter.sh"
LOGGING_SH="$LIBEXEC_DIR/fwlive-logging.sh"
RESOLVE_MAX=32
RESOLVE_TIMEOUT=1
POLL_LINES_MAX=2000

json_escape() {
	awk 'BEGIN { RS = ""; ORS = "" }
	{
		for (i = 1; i <= length($0); i++) {
			c = substr($0, i, 1)
			if (c == "\\") printf "\\\\"
			else if (c == "\"") printf "\\\""
			else if (c == "\t") printf "\\t"
			else if (c == "\r") printf "\\r"
			else if (c == "\n") printf "\\n"
			else printf "%s", c
		}
	}'
}

. "$LOGGING_SH"

slug_key() {
	echo "$1" | tr 'A-Z' 'a-z' | tr ' _' '--'
}

map_add() {
	key="$1"
	val="$2"
	[ -n "$key" ] || return 0
	[ -n "$val" ] || return 0
	esc_key=$(printf '%s' "$key" | json_escape)
	esc_val=$(printf '%s' "$val" | json_escape)
	if [ -n "$OUT" ]; then
		OUT="${OUT},"
	fi
	OUT="${OUT}\"${esc_key}\":\"${esc_val}\""
}

uci_rule_names() {
	uci -q show firewall 2>/dev/null | sed -n "s/^firewall\.@rule\[[0-9]*\]\.name='\(.*\)'$/\1/p"
}

is_uci_style_name() {
	case "$1" in
		*' '*|*'"'*|*"'"*) return 1 ;;
		[!A-Za-z0-9_-]*) return 1 ;;
	esac
	return 0
}

normalize_log_prefix() {
	printf '%s' "$1" | sed 's/[[:space:]]*$//; s/:$//'
}

map_log_prefix_entry() {
	prefix="$1"
	comment="$2"
	label=''

	if [ -n "$comment" ] && is_uci_style_name "$comment"; then
		label="$comment"
	fi

	prefix=$(normalize_log_prefix "$prefix")
	[ -n "$prefix" ] || return 0

	if [ -n "$label" ]; then
		map_add "$prefix" "$label"
		map_add "$(slug_key "$prefix")" "$label"
	else
		cosmetic=$(echo "$prefix" | tr '-' ' ')
		map_add "$prefix" "$cosmetic"
		map_add "$(slug_key "$prefix")" "$cosmetic"
	fi
}

map_uci_rule_names() {
	for name in $(uci_rule_names); do
		map_add "$name" "$name"
		map_add "$(slug_key "$name")" "$name"
	done
}

map_from_nft_stream() {
	while IFS= read -r line; do
		prefix=$(echo "$line" | sed -n 's/.*log prefix "\([^"]*\)".*/\1/p')
		comment=$(echo "$line" | sed -n 's/.*comment "\([^"]*\)".*/\1/p')
		label=''

		case "$comment" in
			"${FW4_TAG}"*)
				suffix="${comment#${FW4_TAG}}"
				if is_uci_style_name "$suffix"; then
					label="$suffix"
				fi
				;;
		esac

		if [ -n "$prefix" ]; then
			if [ -n "$label" ]; then
				map_add "$prefix" "$label"
				map_add "$(slug_key "$prefix")" "$label"
			else
				cosmetic=$(echo "$prefix" | tr '-' ' ')
				map_add "$prefix" "$cosmetic"
				map_add "$(slug_key "$prefix")" "$cosmetic"
			fi
		elif [ -n "$label" ]; then
			map_add "$label" "$label"
			map_add "$(slug_key "$label")" "$label"
		fi
	done
}

map_from_iptables_save_stream() {
	while IFS= read -r line; do
		case "$line" in
			-*) ;;
			*) continue ;;
		esac
		prefix=$(echo "$line" | sed -n 's/.*--log-prefix "\([^"]*\)".*/\1/p')
		comment=$(echo "$line" | sed -n 's/.*--comment "\([^"]*\)".*/\1/p')
		[ -n "$prefix" ] || continue
		map_log_prefix_entry "$prefix" "$comment"
	done
}

detect_firewall_backend() {
	if command -v nft >/dev/null 2>&1 && nft list ruleset >/dev/null 2>&1; then
		printf '%s' nft
		return 0
	fi
	if command -v iptables-save >/dev/null 2>&1; then
		printf '%s' iptables
		return 0
	fi
	printf '%s' unknown
}

build_rules_map() {
	OUT=''
	backend=$(detect_firewall_backend)

	map_uci_rule_names

	case "$backend" in
		nft)
			nft list ruleset 2>/dev/null | map_from_nft_stream
			;;
		iptables)
			iptables-save 2>/dev/null | map_from_iptables_save_stream
			if command -v ip6tables-save >/dev/null 2>&1; then
				ip6tables-save 2>/dev/null | map_from_iptables_save_stream
			fi
			;;
	esac

	printf '{"backend":"%s","rules":{%s}}' "$backend" "$OUT"
}

rulesmap_from_iptables_file() {
	file="$1"
	OUT=''
	[ -n "$file" ] && [ -f "$file" ] || return 1
	map_from_iptables_save_stream < "$file"
	printf '{"backend":"iptables","rules":{%s}}' "$OUT"
}

poll_lines_from_input() {
	input="$1"
	lines=50

	if ! command -v jshn >/dev/null 2>&1; then
		printf '%s' "$lines"
		return 0
	fi

	. /usr/share/libubox/jshn.sh
	json_load "$input" 2>/dev/null || {
		printf '%s' "$lines"
		return 0
	}

	if json_select addresses 2>/dev/null; then
		json_get_var first 1
		json_select ..
		case "$first" in
			''|*[!0-9]*) ;;
			*) lines="$first" ;;
		esac
	fi

	if [ "$lines" -gt "$POLL_LINES_MAX" ] 2>/dev/null; then
		lines="$POLL_LINES_MAX"
	fi

	printf '%s' "$lines"
}

fetch_firewall_logs() {
	input="$1"
	lines=$(poll_lines_from_input "$input")
	stream=false
	oneshot=true
	case "$stream" in
		true|1) stream=true ;;
		*) stream=false ;;
	esac
	case "$oneshot" in
		false|0) oneshot=false ;;
		*) oneshot=true ;;
	esac

	raw=$(sh -c "ubus call log read '{\"lines\":$lines,\"stream\":$stream,\"oneshot\":$oneshot}'" 2>/dev/null) \
		|| raw='{"log":[]}'

	out=$(printf '%s' "$raw" | "$FILTER_SH" 2>/dev/null) || out='{"log":[]}'
	printf '%s' "$out"
}

poll_logs() {
	if [ -n "$3" ]; then
		input="$3"
	else
		input="$(cat)"
	fi
	fetch_firewall_logs "$input"
}

resolve_hostname() {
	ip="$1"
	[ -n "$ip" ] || return 1
	line=""
	if command -v timeout >/dev/null 2>&1; then
		line=$(timeout "$RESOLVE_TIMEOUT" getent hosts "$ip" 2>/dev/null | head -1)
	else
		line=$(getent hosts "$ip" 2>/dev/null | head -1)
	fi
	[ -n "$line" ] || return 1
	set -- $line
	[ "$#" -ge 2 ] || return 1
	printf '%s' "$2"
}

resolve_addresses() {
	if [ -n "$3" ]; then
		input="$3"
	else
		input="$(cat)"
	fi
	count=0
	OUT=''

	if ! command -v jshn >/dev/null 2>&1; then
		printf '{"names":{}}'
		return 0
	fi

	. /usr/share/libubox/jshn.sh
	json_load "$input" 2>/dev/null || {
		printf '{"names":{}}'
		return 0
	}

	if json_select addresses 2>/dev/null; then
		idx=1
		while json_get_type atype "$idx" && [ "$atype" = string ]; do
			[ "$count" -ge "$RESOLVE_MAX" ] && break
			json_get_var ip "$idx"
			name=$(resolve_hostname "$ip")
			if [ -n "$name" ]; then
				map_add "$ip" "$name"
				count=$((count + 1))
			fi
			idx=$((idx + 1))
		done
		json_select ..
	fi

	printf '{"names":{%s}}' "$OUT"
}

run_selftest() {
	input=$(printf 'a\\b"c\nd\te')
	escaped=$(printf '%s' "$input" | json_escape)
	expected=$(printf 'a\\\\b\\"c\\nd\\te')
	if [ "$escaped" != "$expected" ]; then
		echo "json_escape: mismatch" >&2
		return 1
	fi

	if ! command -v jshn >/dev/null 2>&1; then
		echo "skip: jshn not available (poll cap not tested)" >&2
		return 0
	fi

	got=$(poll_lines_from_input '{"addresses":["999999"]}')
	if [ "$got" != "$POLL_LINES_MAX" ]; then
		echo "poll_lines_from_input: expected $POLL_LINES_MAX got $got" >&2
		return 1
	fi

	got=$(poll_lines_from_input '{"addresses":["100"]}')
	if [ "$got" != "100" ]; then
		echo "poll_lines_from_input: expected 100 got $got" >&2
		return 1
	fi

	run_logging_selftest || return 1

	return 0
}

case "$1" in
	__selftest)
		run_selftest
		exit $?
		;;
	__rulesmap_iptables)
		rulesmap_from_iptables_file "$2"
		exit $?
		;;
	list)
		echo '{"rules":{},"backend":"unknown","poll":{"addresses":[]},"resolve":{"addresses":[]},"logging_status":{},"enable_wan_logging":{},"disable_wan_logging":{}}'
		;;
	call)
		case "$2" in
			rules)
				build_rules_map
				;;
			poll)
				poll_logs
				;;
			resolve)
				resolve_addresses
				;;
			logging_status)
				build_logging_status_json
				;;
			enable_wan_logging)
				enable_wan_logging
				;;
			disable_wan_logging)
				disable_wan_logging
				;;
			*)
				echo '{"error":"Method not found"}'
				exit 1
				;;
		esac
		;;
esac
